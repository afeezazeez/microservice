NODE_ENV=development
PORT=3000
IAM_BASE_URL=http://iam-nginx:80
PROJECT_SERVICE_URL=http://project-service:3001
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=8000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_MS=900000
CORS_ORIGINS=http://app.afeez-dev.local,https://app.afeez-dev.local
MAX_REQUEST_SIZE=10mb
TRUST_PROXY=false
JWT_SECRET=microservices-systemctl-secure-jwt-secret-key-2024
