NODE_ENV=development
PORT=3001

# Database
DB_HOST=mysql
DB_PORT=3306
DB_NAME=project_db
DB_USER=root
DB_PASSWORD=rootpassword

# JWT (must match IAM service secret)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Logging
LOG_LEVEL=info

# RabbitMQ
RABBITMQ_URL=amqp://admin:admin123@rabbitmq:5672

# IAM Service URL
IAM_BASE_URL=http://iam-nginx:80
